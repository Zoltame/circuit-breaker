{
  "name": "circuit-breaker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "spike:1click": "tsx --env-file-if-exists=.env scripts/spike-1click.ts",
    "agent": "tsx --env-file-if-exists=.env scripts/run-agent.ts",
    "propose": "tsx --env-file-if-exists=.env scripts/propose.ts",
    "contract": "tsx scripts/contract.ts",
    "vault:deploy": "tsx --env-file=.env scripts/vault-deploy.ts",
    "vault:attack": "tsx --env-file=.env scripts/vault-attack.ts",
    "dashboard": "tsx --env-file-if-exists=.env packages/dashboard/src/server.ts",
    "dashboard:swarm": "tsx --env-file-if-exists=.env packages/dashboard/src/server.ts --policy policies/swarm.yaml --data data-swarm --agent",
    "dao": "tsx --env-file=.env scripts/dao.ts",
    "vault:trip": "tsx --env-file=.env scripts/vault-trip.ts",
    "demo": "tsx --env-file-if-exists=.env packages/dashboard/src/server.ts --onchain --demo --data data-demo",
    "replay:build": "tsx scripts/build-replay.ts",
    "agent:rotate-key": "tsx --env-file=.env scripts/agent-key.ts",
    "journal:verify": "tsx --env-file-if-exists=.env scripts/journal-verify.ts"
  },
  "devDependencies": {
    "@circuit-breaker/agent": "workspace:*",
    "@circuit-breaker/executor": "workspace:*",
    "@circuit-breaker/policy-engine": "workspace:*",
    "@types/node": "^24.0.0",
    "near-api-js": "7.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}

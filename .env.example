# Copy to .env and fill in. Never commit .env.

# --- NEAR (testnet only during development) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Vault contract account (deployed by `pnpm vault:deploy`, then owned by the DAO)
VAULT_ACCOUNT_ID=
# Agent account: holds only a function-call key scoped to the vault
AGENT_ACCOUNT_ID=
# Agent's function-call private key (ed25519:...). Never a full-access key.
AGENT_PRIVATE_KEY=
# Whitelisted trading venue the vault may send to (testnet stand-in for intents.near)
VENUE_ACCOUNT_ID=
# Sputnik DAO that owns the vault (<name>.sputnikv2.testnet, created by `pnpm dao create`)
DAO_ACCOUNT_ID=
# Council members, comma-separated (a council list gives a 2-of-3 vote threshold)
DAO_COUNCIL=

# --- NEAR Intents 1Click (quotes are mainnet; we only use dry: true) ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Optional partner JWT (Distribution Channel key). Without it: extra platform fee.
ONECLICK_JWT=

# --- NEAR Intents SHIELD (optional, incident feed) ---
SHIELD_JWT=
